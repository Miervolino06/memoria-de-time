{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/inicio-de-sessao.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(bash scripts/checar-memoria.sh)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git show*)",
      "PowerShell(git fetch*)",
      "PowerShell(git pull*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git config user.name)",
      "PowerShell(git config user.email)",
      "PowerShell(bash scripts/checar-memoria.sh)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(git reset*--hard*)",
      "Bash(git clean*)",
      "Bash(git rebase -i*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f*)",
      "PowerShell(git push* +*)",
      "PowerShell(git reset*--hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git rebase -i*)"
    ]
  }
}
